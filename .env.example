# Django
DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=reusable_kyc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Blockchain
BLOCKCHAIN_RPC_URL=http://anvil:8545
ROLE_MANAGER_ADDRESS=your-role-manager-contract-address
KYC_REGISTRY_ADDRESS=your-kyc-registry-contract-address
CHAIN_ID=31337

# For Sepolia (uncomment when deploying)
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-infura-project-id
# CHAIN_ID=11155111
# ROLE_MANAGER_ADDRESS=your-sepolia-role-manager-address
# KYC_REGISTRY_ADDRESS=your-sepolia-kyc-registry-address

# Pinata
PINATA_JWT=your-pinata-jwt
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key
PINATA_GATEWAY=https://your-gateway.mypinata.cloud

# Blockchain Account
ADMIN_PRIVATE_KEY=your-admin-private-key

# Encryption
KYC_ENCRYPTION_KEY=your-fernet-key